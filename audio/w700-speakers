#!/usr/bin/python3
# SPDX-License-Identifier: GPL-2.0-or-later
"""w700-speakers: enable the internal speakers of the Samsung Galaxy TabPro S (SM-W700).

Codec: Realtek ALC298 (HDA subsystem 144d:c135). The speakers are driven by two
Maxim MAX98925 smart amps on the codec's internal bus bridge (7-bit addr 0x31, 0x34).
Linux never configures them, so the speakers stay silent.

This writes the amp register table that Windows' RTKVHD64.sys programs at driver start
(recorded from the real chip by running the Windows driver in a VM whose codec verbs were
forwarded to the tablet), with Linux's own stereo slot selection and gain, then enables the
amps (reg 0x38 = 0x80). The amps keep this until they lose power (flat battery), so it is
written on every boot and resume.
Bridge protocol (ALC298 vendor coefs on NID 0x20): 0x22 addr, 0x23 reg, 0x25 data,
0x26 cmd/status (bit14 busy), 0x28 read data, 0x89 reg-hi. Commands: 0xb010/0xb018 8-bit
reg+data write/read, 0xb013/0xb01b 16-bit reg+data write/read.
"""
import fcntl, os, struct, sys, time

DEV = '/dev/snd/hwC0D0'
FD = None
def verb(nid, v, p=0):
    cmd = (nid << 24) | (v << 8) | p
    return struct.unpack('II', fcntl.ioctl(FD, 0xC0084811, struct.pack('II', cmd, 0)))[1]
def coef_w(idx, val, nid=0x20): verb(nid, 0x500, idx); verb(nid, 0x400, val)
def coef_r(idx, nid=0x20): verb(nid, 0x500, idx); return verb(nid, 0xc00, 0)
def _wait():
    for _ in range(100):
        if not coef_r(0x26) & 0x4000: return
        time.sleep(0.001)
def _start(): coef_w(0x26, coef_r(0x26) | 0x4000)
def w16(dev, reg, val):
    _wait(); _start(); coef_w(0x22, dev); coef_w(0x25, val); coef_w(0x23, reg); coef_w(0x26, 0xb013)
def w8(dev, reg, val):
    _wait(); _start(); coef_w(0x22, dev); coef_w(0x25, val); coef_w(0x23, reg); coef_w(0x26, 0xb010); _wait()
def r8(dev, reg):
    _wait(); _start(); coef_w(0x22, dev); coef_w(0x23, reg); coef_w(0x26, 0xb018); _wait(); time.sleep(0.002)
    return coef_r(0x28) & 0xff

AMPS = (0x31, 0x34)          # left, right (verified by listening test)
# MAX98925 register table as Windows programs it (0x2d, gain/input select, is set separately).
# The essential differences from the chip's power-on state: DAI clock/format (0x1a, 0x1b, 0x1f,
# 0x20), TDM slots and V/I-sense output (0x21-0x23), DOUT drive (0x27-0x2a), filters (0x2c),
# speaker mode (0x2f), ALC (0x34), boost limiter (0x3a). Without them the amps stay silent.
AMP_TABLE = (
    (0x0b, 0x00), (0x0c, 0x00), (0x0d, 0x00),             # IRQ enables
    (0x1a, 0x40), (0x1b, 0x86), (0x1f, 0x04),             # DAI clock: BCLK source, 48 kHz
    (0x20, 0x51), (0x21, 0x08),                           # format (16-bit TDM), slot select
    (0x22, 0x20), (0x23, 0x24), (0x24, 0x00), (0x26, 0x00),  # DOUT VMON/IMON slots
    (0x27, 0x00), (0x28, 0x00), (0x29, 0x00), (0x2a, 0x00),  # DOUT Hi-Z off
    (0x2b, 0x02), (0x2c, 0x10), (0x2e, 0x02), (0x2f, 0x02),  # drive, filters, ramp, spk mode
    (0x30, 0x0a), (0x31, 0x00), (0x32, 0x00), (0x33, 0x00),  # ALC threshold/attack/release
    (0x34, 0x12), (0x35, 0x01), (0x36, 0x90), (0x37, 0x00),  # ALC cfg, boost, block enable
    (0x39, 0x00), (0x3a, 0xf0),                           # boost limiter
)
CONFS = ('/etc/tabpro-s/speakers.conf', '/etc/w700-speakers.conf')  # GAIN=<0..31> (dB = GAIN-6; fw default 25)
TUNED_SRC = '/usr/lib/tuned/profiles'
TUNED_DST = '/etc/tuned/profiles'
TUNED_TAG = '# generated by tabpro-s-speakers from the stock profile: audio power saving disabled\n'

def keep_codec_awake():
    """The codec's internal I2S block loses its setup when the codec runtime-suspends, so disable
    HDA power saving and make tuned's profiles (which set [audio] timeout=10) agree. The tuned
    overrides are regenerated from the installed stock profiles every boot, so they never go stale."""
    changed = False
    for name in ('balanced', 'powersave'):
        src = os.path.join(TUNED_SRC, name, 'tuned.conf')
        if not os.path.exists(src):
            continue
        out, in_audio = [], False
        for line in open(src):
            if line.startswith('['):
                in_audio = line.strip() == '[audio]'
            if in_audio and line.split('=')[0].strip() == 'timeout':
                line = 'timeout=0\n'
            out.append(line)
        new = TUNED_TAG + ''.join(out)
        dst = os.path.join(TUNED_DST, name, 'tuned.conf')
        try:
            old = open(dst).read()
        except OSError:
            old = None
        if old is not None and not old.startswith(TUNED_TAG):
            continue                      # an admin's own override: leave it alone
        if old != new:
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            open(dst, 'w').write(new)
            changed = True
    if changed and os.system('systemctl -q is-active tuned') == 0:
        os.system('systemctl try-restart tuned')
    try:
        open('/sys/module/snd_hda_intel/parameters/power_save', 'w').write('0')
    except OSError:
        pass

def load_gain():
    for conf in CONFS:
      try:
        for line in open(conf):
            k, _, v = line.partition('=')
            if k.strip() == 'GAIN': return max(0, min(31, int(v.strip(), 0)))
      except (OSError, ValueError):
        continue
    return 25

def main():
    global FD
    for _ in range(100):
        if os.path.exists(DEV): break
        time.sleep(0.2)
    FD = os.open(DEV, os.O_RDWR)
    vendor = verb(0, 0xf00, 0); ssid = verb(1, 0xf20, 0)
    if vendor != 0x10ec0298 or ssid != 0x144dc135:
        print(f"w700-speakers: not a TabPro S codec (vendor {vendor:#x} ssid {ssid:#x}); doing nothing"); return 0
    keep_codec_awake()
    if r8(0x31, 0xff) not in (0x51, 0x80):
        print("w700-speakers: MAX98925 not found at 0x31; doing nothing"); return 1
    gain = load_gain()
    for ch, d in enumerate(AMPS):
        w8(d, 0x38, 0x00)                             # disable while configuring
        for r, v in AMP_TABLE: w8(d, r, v)
        for r in (0x0e, 0x0f, 0x10): w8(d, r, 0xff)   # clear latched IRQ flags
        w8(d, 0x2d, (ch << 5) | gain)                 # GAIN: DAC_IN_SEL left/right DAI + SPK_GAIN
        w8(d, 0x38, 0x80)                             # MAX98925 GLOBAL_ENABLE
    st = [f"{d:#04x}:en={r8(d, 0x38):#04x},gain={r8(d, 0x2d):#04x},fmt={r8(d, 0x20):#04x}" for d in AMPS]
    print("w700-speakers: enabled", " ".join(st))
    return 0

if __name__ == '__main__':
    sys.exit(main())
