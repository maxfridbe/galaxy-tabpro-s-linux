[Unit]
Description=Samsung Galaxy TabPro S AMOLED brightness (Parade TCON gamma control)
After=systemd-backlight@backlight:intel_backlight.service
ConditionPathExists=/etc/tabpro-s/amoled-profile.json

[Service]
ExecStart=/usr/local/sbin/tabpro-s-brightness
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
