+/* Settings for Samsung Galaxy TabPro S (SM-W700): 2x Sony IMX241 (INT347F).
+ * Derived from the Windows SkcController.sys (Samsung SSTps68470 classes) and
+ * imx241.sys power configuration. :00 = rear (world facing), :01 = front. */
+static struct regulator_consumer_supply w700_core_consumer_supplies[] = {
+	REGULATOR_SUPPLY("dvdd", "i2c-INT347F:00"),
+};
+static struct regulator_consumer_supply w700_ana_consumer_supplies[] = {
+	REGULATOR_SUPPLY("avdd", "i2c-INT347F:00"),
+};
+static struct regulator_consumer_supply w700_vcm_consumer_supplies[] = {
+	REGULATOR_SUPPLY("vdd", "i2c-INT347F:00-VCM"),
+};
+static struct regulator_consumer_supply w700_vsio_consumer_supplies[] = {
+	REGULATOR_SUPPLY("dovdd", "i2c-INT347F:00"),
+	REGULATOR_SUPPLY("vsio", "i2c-INT347F:00-VCM"),
+	REGULATOR_SUPPLY("vsio", "i2c-INT347F:01"),	/* Windows: S_I2C_CTL=0x02 for front */
+};
+static struct regulator_consumer_supply w700_aux1_consumer_supplies[] = {
+	REGULATOR_SUPPLY("dvdd", "i2c-INT347F:01"),
+};
+static struct regulator_consumer_supply w700_aux2_consumer_supplies[] = {
+	REGULATOR_SUPPLY("dovdd", "i2c-INT347F:01"),
+};
+#define W700_REG(_name, _uv, _supplies)						\
+static const struct regulator_init_data w700_##_name##_reg_init_data = {	\
+	.constraints = {							\
+		.min_uV = _uv, .max_uV = _uv, .apply_uV = true,			\
+		.valid_ops_mask = REGULATOR_CHANGE_STATUS,			\
+	},									\
+	.num_consumer_supplies = ARRAY_SIZE(_supplies),				\
+	.consumer_supplies = _supplies,						\
+}
+W700_REG(core, 1200000, w700_core_consumer_supplies);
+W700_REG(ana, 2815200, w700_ana_consumer_supplies);
+W700_REG(vcm, 2815200, w700_vcm_consumer_supplies);
+W700_REG(vsio, 1800600, w700_vsio_consumer_supplies);
+W700_REG(aux1, 1213200, w700_aux1_consumer_supplies);
+W700_REG(aux2, 1800600, w700_aux2_consumer_supplies);
+
+static const struct regulator_init_data w700_vio_reg_init_data = {
+	.constraints = {
+		.min_uV = 1800600, .max_uV = 1800600, .apply_uV = true,
+		.always_on = true,
+	},
+};
+
+static const struct tps68470_regulator_platform_data w700_tps68470_pdata = {
+	.reg_init_data = {
+		[TPS68470_CORE] = &w700_core_reg_init_data,
+		[TPS68470_ANA]  = &w700_ana_reg_init_data,
+		[TPS68470_VCM]  = &w700_vcm_reg_init_data,
+		[TPS68470_VIO]  = &w700_vio_reg_init_data,
+		[TPS68470_VSIO] = &w700_vsio_reg_init_data,
+		[TPS68470_AUX1] = &w700_aux1_reg_init_data,
+		[TPS68470_AUX2] = &w700_aux2_reg_init_data,
+	},
+};
+
+static struct gpiod_lookup_table w700_rear_gpios = {
+	.dev_id = "i2c-INT347F:00",
+	.table = {
+		GPIO_LOOKUP("tps68470-gpio", 9, "reset", GPIO_ACTIVE_LOW),
+		GPIO_LOOKUP("tps68470-gpio", 7, "powerdown", GPIO_ACTIVE_LOW),
+		{ }
+	}
+};
+
+static struct gpiod_lookup_table w700_front_gpios = {
+	.dev_id = "i2c-INT347F:01",
+	.table = {
+		GPIO_LOOKUP_IDX("tps68470-gpio", 4, "enable", 0, GPIO_ACTIVE_HIGH),
+		GPIO_LOOKUP("tps68470-gpio", 5, "reset", GPIO_ACTIVE_LOW),
+		GPIO_LOOKUP("tps68470-gpio", 6, "powerdown", GPIO_ACTIVE_LOW),
+		{ }
+	}
+};
+
+static const struct int3472_tps68470_board_data w700_tps68470_board_data = {
+	.dev_name = "i2c-INT3472:04",
+	.tps68470_regulator_pdata = &w700_tps68470_pdata,
+	.n_gpiod_lookups = 2,
+	.tps68470_gpio_lookup_tables = {
+		&w700_rear_gpios,
+		&w700_front_gpios,
+	},
+};
